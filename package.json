{
  "name": "hello-agent",
  "private": true,
  "version": "0.1.0-spike",
  "description": "Desktop coding agent spike — validates docs/desktop-agent-tech-stack.md §10",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @hello-agent/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "probe:isolation": "cd apps/desktop && pnpm exec tsx ../../spikes/probes/isolation-probe.ts",
    "probe:permission": "cd apps/desktop && pnpm exec tsx ../../spikes/probes/permission-probe.ts",
    "probe:session-rebind": "cd apps/desktop && pnpm exec tsx ../../spikes/probes/session-rebind-probe.ts",
    "probe:dispose-rebuild": "cd apps/desktop && pnpm exec tsx ../../spikes/probes/dispose-rebuild-probe.ts",
    "probe:delta-stress": "cd apps/desktop && pnpm exec tsx ../../spikes/probes/delta-stress-probe.ts",
    "probe:sandbox": "bash spikes/probes/sandbox-probe.sh",
    "probe:auth": "bash spikes/probes/auth-smoke.sh",
    "probe:watchdog": "cd apps/desktop && pnpm exec tsx ../../spikes/probes/watchdog-probe.ts",
    "probe:trust-persist": "cd apps/desktop && pnpm exec tsx ../../spikes/probes/trust-persist-probe.ts",
    "probe:e2e-llm": "cd apps/desktop && pnpm exec tsx ../../spikes/probes/e2e-llm-probe.ts",
    "probe:all": "pnpm probe:isolation && pnpm probe:permission && pnpm probe:session-rebind && pnpm probe:dispose-rebuild && pnpm probe:delta-stress && pnpm probe:sandbox && pnpm probe:e2e-llm && pnpm probe:watchdog && pnpm probe:trust-persist",
    "probe:package": "bash spikes/probes/package-probe.sh"
  },
  "packageManager": "pnpm@11.21.0"
}
